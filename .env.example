# Use a private Supabase Storage bucket named pactrieve-documents
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pactrieve-documents

# Phase 3 grounded chat — OpenAI-compatible provider (Groq / OpenRouter / OpenAI / etc.)
# Never expose these as NEXT_PUBLIC_*. Keep them server-side only.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional: LLM_TIMEOUT_MS=45000  LLM_MAX_TOKENS=1024

# Required on any publicly reachable host (Vercel Production + Preview).
# Shared evaluator passphrase (not user accounts). High-entropy recommended.
# On Vercel, omitting this fails closed (APIs return 503) instead of exposing documents.
# Leave empty for local single-user development only.
# PACTRIEVE_ACCESS_TOKEN=
# Optional local simulation of hosted fail-closed behaviour:
# PACTRIEVE_ENFORCE_ACCESS_GATE=1
